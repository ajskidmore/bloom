rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    // `uid` has accepted the signed-in user as a friend.
    function isFriendOf(uid) { return signedIn() && exists(/databases/$(database)/documents/profiles/$(uid)/friends/$(request.auth.uid)); }
    function requestExists(from, to) { return exists(/databases/$(database)/documents/requests/$(from + '_' + to)); }
    function shortStr(v, n) { return v is string && v.size() <= n; }

    // Each signed-in user can only read and write their own data.
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /days/{day}   { allow read, write: if isOwner(uid); }
      match /meals/{meal} { allow read, write: if isOwner(uid); }

      // Meal photos: compressed data URLs, kept under Firestore's 1 MB doc limit.
      match /photos/{mealId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.data is string
          && request.resource.data.data.size() < 900000;
      }
    }

    // ---------- Friends ----------
    // Friend codes: anyone signed in can look up one code (not list them). Codes are never reassigned.
    match /codes/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && code.matches('^[A-Z0-9]{6}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
    }

    // Progress snapshot: readable by the owner and the owner's friends only. No food, weight, photos or journal.
    match /profiles/{uid} {
      allow read: if isOwner(uid) || isFriendOf(uid);
      allow write: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'photo', 'code', 'flower', 'flowerName', 'day', 'done', 'total', 'streak', 'finished', 'updatedAt'])
        && (!('name' in request.resource.data) || shortStr(request.resource.data.name, 40))
        && (!('photo' in request.resource.data) || shortStr(request.resource.data.photo, 500))
        && (!('flowerName' in request.resource.data) || shortStr(request.resource.data.flowerName, 20))
        && (!('finished' in request.resource.data) || (request.resource.data.finished is list && request.resource.data.finished.size() <= 20));

      // Friend list. Written by both people when a request is accepted; either side can end it.
      match /friends/{fid} {
        allow read: if isOwner(uid);
        allow create: if request.resource.data.keys().hasOnly(['since']) && (
          (isOwner(uid) && requestExists(fid, uid))      // I'm accepting their request
          || (isOwner(fid) && requestExists(uid, fid))   // they asked me; I'm accepting and adding myself to their list
        );
        allow delete: if isOwner(uid) || isOwner(fid);
      }

      // Feed posts: workouts the owner chose to share, plus habit milestones. Friends can read them and
      // add or remove only their own kudos. Food, weight, photos, sleep and the journal never go here.
      match /posts/{pid} {
        allow read: if isOwner(uid) || isFriendOf(uid);
        allow delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['kind', 'at', 'day', 'title', 'emoji', 'workout', 'minutes', 'kcal', 'intensity', 'note', 'done', 'total', 'streak', 'kudos'])
          && request.resource.data.kind in ['workout', 'allDone', 'streak']
          && request.resource.data.at is number
          && (!('title' in request.resource.data) || shortStr(request.resource.data.title, 60))
          && (!('note' in request.resource.data) || shortStr(request.resource.data.note, 200))
          && (!('kudos' in request.resource.data) || request.resource.data.kudos is map);
        // A friend giving or taking back kudos: only their own entry in the kudos map may change.
        allow update: if isFriendOf(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kudos'])
          && request.resource.data.get('kudos', {}).diff(resource.data.get('kudos', {})).affectedKeys().hasOnly([request.auth.uid])
          && (!(request.auth.uid in request.resource.data.get('kudos', {})) || shortStr(request.resource.data.kudos[request.auth.uid], 40));
      }

      // Cheers and "request accepted" notes, sent only by friends.
      match /inbox/{id} {
        allow read, delete: if isOwner(uid);
        allow create: if isFriendOf(uid)
          && request.resource.data.keys().hasOnly(['type', 'from', 'fromName', 'fromPhoto', 'at'])
          && request.resource.data.type in ['cheer', 'accepted']
          && request.resource.data.from == request.auth.uid
          && shortStr(request.resource.data.fromName, 40)
          && shortStr(request.resource.data.fromPhoto, 500)
          && request.resource.data.at == request.time;
      }
    }

    // Friend requests, stored as {from}_{to}. Only the two people involved can see or remove one.
    match /requests/{rid} {
      allow get, delete: if signedIn() && (rid.matches(request.auth.uid + '_.+') || rid.matches('.+_' + request.auth.uid));
      allow list: if signedIn() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'to', 'fromName', 'fromPhoto', 'toCode', 'at'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to != request.auth.uid
        && rid == request.auth.uid + '_' + request.resource.data.to
        && shortStr(request.resource.data.fromName, 40)
        && shortStr(request.resource.data.fromPhoto, 500)
        && shortStr(request.resource.data.toCode, 6)
        && request.resource.data.at == request.time
        && !exists(/databases/$(database)/documents/profiles/$(request.resource.data.to)/friends/$(request.auth.uid));
    }
  }
}
